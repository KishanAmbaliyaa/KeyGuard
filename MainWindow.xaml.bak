<Window x:Class="KeyloggerDetector.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:KeyloggerDetector.Converters"
        xmlns:controls="using:CommunityToolkit.WinUI.UI.Controls">
    
    <Grid Background="#1E1E1E">
    
        <Grid.Resources>
            <!-- Modern Dark Theme Resources -->
            
            <!-- Converters -->
            <local:StringToVisibilityConverter x:Key="StringToVisibilityConverter"/>
            <local:ThreatLevelToColorConverter x:Key="ThreatLevelToColorConverter"/>
            <local:ProcessCategoryToIconConverter x:Key="ProcessCategoryToIconConverter"/>
            <local:BoolToFontWeightConverter x:Key="BoolToFontWeightConverter"/>
        
        <!-- Text Alignment Styles -->
        <Style x:Key="CenterAlignedTextBlock" TargetType="TextBlock">
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
        
        <Style x:Key="LeftAlignedTextBlock" TargetType="TextBlock">
            <Setter Property="TextAlignment" Value="Left"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>
        
        <Style x:Key="NavigationButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#CCCCCC"/>
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="Width" Value="50"/>
            <Setter Property="Height" Value="50"/>
            <Setter Property="Margin" Value="0,5"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" 
                                CornerRadius="8" BorderThickness="0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#3E3E42"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#FF4444"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ModernButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#FF4444"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="20,10"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" 
                                CornerRadius="6" BorderThickness="0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#FF6666"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#DD2222"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ThreatItemStyle" TargetType="ListViewItem">
            <Setter Property="Background" Value="#2A2A2A"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Margin" Value="0,2"/>
            <Setter Property="Padding" Value="15,10"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListViewItem">
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Main Layout Grid -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="40"/>   <!-- Title Bar -->
            <RowDefinition Height="*"/>    <!-- Main Content -->
        </Grid.RowDefinitions>

        <!-- Custom Title Bar -->
        <Border Grid.Row="0" Background="#2D2D30" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="15,0">
                    <TextBlock Text="🛡️" FontSize="16" Foreground="#FF4444" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <TextBlock Text="KeyGuard Pro" FontSize="14" FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center"/>
                    <TextBlock Text="v1.0" FontSize="11" Foreground="#888" VerticalAlignment="Center" Margin="10,0,0,0"/>
                </StackPanel>
                
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="—" Click="MinimizeButton_Click" Width="45" Height="30" Background="Transparent" 
                            Foreground="#CCC" BorderThickness="0" FontSize="16"/>
                    <Button Content="✕" Click="CloseButton_Click" Width="45" Height="30" Background="Transparent" 
                            Foreground="#CCC" BorderThickness="0" FontSize="14"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Content -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="80"/>    <!-- Navigation Sidebar -->
                <ColumnDefinition Width="*"/>     <!-- Main Content Area -->
            </Grid.ColumnDefinitions>

            <!-- Left Navigation Sidebar -->
            <Border Grid.Column="0" Background="#2D2D30">
                <StackPanel Margin="15,20">
                    <Button x:Name="ProcessNavBtn" Content="⚙️" Style="{StaticResource NavigationButtonStyle}" 
                            Click="NavigateToProcesses" ToolTip="Process Monitor"/>
                    <Button x:Name="ScannerNavBtn" Content="🔍" Style="{StaticResource NavigationButtonStyle}" 
                            Click="NavigateToScanner" ToolTip="File Scanner"/>
                    <Button x:Name="PlaygroundNavBtn" Content="🎮" Style="{StaticResource NavigationButtonStyle}" 
                            Click="NavigateToPlayground" ToolTip="Input Playground"/>
                    <Button x:Name="HistoryNavBtn" Content="📊" Style="{StaticResource NavigationButtonStyle}" 
                            Click="NavigateToHistory" ToolTip="Threat History"/>
                    <Button x:Name="SettingsNavBtn" Content="⚙" Style="{StaticResource NavigationButtonStyle}" 
                            Click="NavigateToSettings" ToolTip="Settings"/>
                </StackPanel>
            </Border>

            <!-- Main Content Frame -->
            <Border Grid.Column="1" Background="#1E1E1E">
                <Grid x:Name="MainContentGrid">
                    
                    <!-- Process Monitor Page (Default) -->
                    <Grid x:Name="ProcessMonitorPage" Visibility="Visible">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>    <!-- Header -->
                            <RowDefinition Height="Auto"/>    <!-- Controls -->
                            <RowDefinition Height="Auto"/>    <!-- Tab Headers -->
                            <RowDefinition Height="*"/>       <!-- Process List -->
                        </Grid.RowDefinitions>
                        
                        <!-- Header Section -->
                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="30,30,30,20">
                            <TextBlock Text="🔄" FontSize="24" Foreground="#FF4444" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <TextBlock Text="Process Monitor" FontSize="28" FontWeight="Light" 
                                       Foreground="White" VerticalAlignment="Center"/>
                            <TextBlock x:Name="ProcessCountLabel" Text="Loading..." 
                                       Foreground="#AAAAAA" FontSize="14" VerticalAlignment="Center" Margin="20,0,0,0"/>
                        </StackPanel>
                        
                        <!-- Controls Section -->
                        <Border Grid.Row="1" Background="#2A2A2A" CornerRadius="6" Margin="30,0,30,15" Padding="20,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                
                                <Button Grid.Column="0" Content="🔄 Refresh" Style="{StaticResource ModernButtonStyle}" 
                                        Click="RefreshProcesses_Click" Margin="0,0,15,0" Padding="12,8"
                                        ToolTip="Refresh process list"/>
                                
                                <TextBox x:Name="ProcessSearchBox" Grid.Column="1" Height="36" 
                                         Background="#3A3A3A" Foreground="White" BorderBrush="#555" BorderThickness="1"
                                         Padding="12,8" FontSize="14" VerticalContentAlignment="Center"
                                         Text="Search processes..." TextChanged="ProcessSearchBox_TextChanged"
                                         ToolTip="Filter by process name, PID, or threat level"/>
                                
                                <Button Grid.Column="2" x:Name="EndTaskButton" Content="⚠️ End Task" 
                                        Background="#DC2626" Foreground="White" BorderThickness="0" 
                                        Padding="12,8" FontSize="12" FontWeight="SemiBold" Margin="15,0,0,0"
                                        Click="TerminateSelectedProcess_Click" IsEnabled="False"
                                        ToolTip="Terminate selected process"/>
                            </Grid>
                        </Border>
                        
                        <!-- All Processes Header -->
                        <Border Grid.Row="2" Background="#363636" Margin="30,0,30,0" 
                                BorderThickness="0,0,0,1" BorderBrush="#555">
                            <StackPanel Orientation="Horizontal" Margin="20,8,20,8">
                                <TextBlock Text="All Processes &amp; Services" FontSize="14" FontWeight="SemiBold" 
                                          Foreground="White" VerticalAlignment="Center"/>
                                <TextBlock x:Name="ProcessCountText" Text="(Loading...)" FontSize="13" 
                                          Foreground="#CCC" VerticalAlignment="Center" Margin="10,0,0,0"/>
                            </StackPanel>
                        </Border>
                        
                        <!-- Process List Section (Task Manager Style) -->
                        <Border Grid.Row="3" Background="#2A2A2A" Margin="30,0,30,30">
                            <DataGrid x:Name="ProcessDataGrid" 
                                      Background="Transparent" Foreground="White" 
                                      BorderThickness="0" GridLinesVisibility="Horizontal" 
                                      HorizontalGridLinesBrush="#444" RowBackground="#2A2A2A" 
                                      AlternatingRowBackground="#333" HeadersVisibility="Column"
                                      AutoGenerateColumns="False" IsReadOnly="True" 
                                      CanUserResizeRows="False" CanUserSortColumns="True"
                                      SelectionMode="Single" SelectionChanged="ProcessDataGrid_SelectionChanged"
                                      RowHeight="36" FontSize="13">
                                
                                <!-- Custom DataGrid Styles -->
                                <DataGrid.Resources>
                                    <Style TargetType="DataGridColumnHeader">
                                        <Setter Property="Background" Value="#404040"/>
                                        <Setter Property="Foreground" Value="White"/>
                                        <Setter Property="BorderBrush" Value="#555"/>
                                        <Setter Property="BorderThickness" Value="0,0,1,1"/>
                                        <Setter Property="Padding" Value="12,8"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                        <Setter Property="FontSize" Value="12"/>
                                        <Setter Property="HorizontalContentAlignment" Value="Left"/>
                                    </Style>
                                    
                                    <Style TargetType="DataGridRow">
                                        <Setter Property="Background" Value="#2A2A2A"/>
                                        <Setter Property="BorderThickness" Value="0"/>
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#3A3A3A"/>
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter Property="Background" Value="#0078D4"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                    
                                    <Style TargetType="DataGridCell">
                                        <Setter Property="BorderThickness" Value="0"/>
                                        <Setter Property="Padding" Value="12,8"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                    </Style>
                                </DataGrid.Resources>
                                
                                <DataGrid.Columns>
                                    <!-- Clean Process Name Column -->
                                    <DataGridTemplateColumn Header="Process Name" Width="*" SortMemberPath="ProcessDetails.Name">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0">
                                                    <!-- Clean process name display -->
                                                    <TextBlock Text="{Binding ProcessDetails.Name}" 
                                                               FontSize="13" Foreground="White" 
                                                               VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    
                                    <!-- Status Column with Clean Design -->
                                    <DataGridTemplateColumn Header="Status" Width="150" SortMemberPath="ProcessDetails.ThreatLevel">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0">
                                                    <Ellipse Width="6" Height="6" Margin="0,0,6,0">
                                                        <Ellipse.Fill>
                                                            <SolidColorBrush Color="{Binding ProcessDetails.ThreatLevel, Converter={StaticResource ThreatLevelToColorConverter}}"/>
                                                        </Ellipse.Fill>
                                                    </Ellipse>
                                                    <TextBlock Text="{Binding ProcessDetails.ThreatLevel}" 
                                                               FontSize="12" Foreground="#CCC"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    
                                    <!-- Actions Column -->
                                    <DataGridTemplateColumn Header="Actions" Width="150">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Button Content="End task" Background="#DC2626" Foreground="White" 
                                                        BorderThickness="0" Padding="8,4" FontSize="11"
                                                        Click="TerminateProcess_Click" 
                                                        CommandParameter="{Binding}"
                                                        ToolTip="Terminate this process"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Border>
                    </Grid>

                    <!-- File Scanner Page -->
                    <Grid x:Name="ScannerPage" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>   <!-- Header -->
                            <RowDefinition Height="Auto"/>   <!-- Controls -->
                            <RowDefinition Height="*"/>      <!-- Results -->
                            <RowDefinition Height="Auto"/>   <!-- Summary -->
                        </Grid.RowDefinitions>
                        
                        <!-- Header -->
                        <StackPanel Grid.Row="0" Margin="40,40,40,20">
                            <TextBlock Text="File Scanner" FontSize="28" FontWeight="Light" 
                                       Foreground="White" HorizontalAlignment="Left"/>
                            <TextBlock x:Name="ScannerStatusText" Text="Hybrid Analysis: Real-time + VirusTotal" FontSize="14" 
                                       Foreground="#888" HorizontalAlignment="Left" Margin="0,5,0,0"/>
                        </StackPanel>
                        
                        <!-- Scan Controls -->
                        <Border Grid.Row="1" Background="#2A2A2A" CornerRadius="6" Margin="40,0,40,20" Padding="25,20">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                
                                <!-- Folder Selection -->
                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button x:Name="SelectFolderButton" Content="📁 Select Folder" 
                                            Style="{StaticResource ModernButtonStyle}" 
                                            Click="SelectFolderButton_Click" Margin="0,0,15,0" Padding="15,10"/>
                                    <TextBlock x:Name="SelectedFolderText" Text="No folder selected" 
                                               Foreground="#CCC" VerticalAlignment="Center" FontSize="14" 
                                               TextTrimming="CharacterEllipsis" MaxWidth="400"/>
                                </StackPanel>
                                
                                <!-- Scan Options -->
                                <StackPanel Grid.Column="1" Orientation="Vertical" Margin="20,0">
                                    <CheckBox x:Name="UseVirusTotalCheckBox" Content="Use VirusTotal API" 
                                              IsChecked="True" Foreground="#CCC" FontSize="12" Margin="0,0,0,5"/>
                                    <CheckBox x:Name="IncludeSubfoldersCheckBox" Content="Include subfolders" 
                                              IsChecked="True" Foreground="#CCC" FontSize="12"/>
                                </StackPanel>
                                
                                <!-- Scan Button -->
                                <Button x:Name="ScanButton" Grid.Column="2" Content="🔍 START SCAN" 
                                        Style="{StaticResource ModernButtonStyle}" 
                                        Click="ScanButton_Click" IsEnabled="False" 
                                        Width="140" Height="45" FontSize="14" FontWeight="Bold"/>
                            </Grid>
                        </Border>
                        
                        <!-- Scan Results -->
                        <Border Grid.Row="2" Background="#2A2A2A" CornerRadius="6" Margin="40,0,40,20">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                
                                <!-- Progress Bar -->
                                <Border Grid.Row="0" Background="#3A3A3A" Padding="20,15" BorderThickness="0,0,0,1" BorderBrush="#555">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        
                                        <StackPanel Grid.Column="0">
                                            <ProgressBar x:Name="ScanProgressBar" Height="8" Background="#555" 
                                                         Foreground="#FF4444" BorderThickness="0" Margin="0,0,0,8"/>
                                            <TextBlock x:Name="ScanStatusText" Text="Ready to scan" 
                                                       Foreground="#CCC" FontSize="12"/>
                                        </StackPanel>
                                        
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock x:Name="ProgressText" Text="0%" 
                                                       Foreground="#FF4444" FontSize="14" FontWeight="Bold" Margin="0,0,15,0"/>
                                            <Button x:Name="CancelScanButton" Content="✕ Cancel" 
                                                    Background="#666" Foreground="White" BorderThickness="0" 
                                                    Padding="12,6" FontSize="11" Click="CancelScanButton_Click" 
                                                    Visibility="Collapsed"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                                
                                <!-- Results List -->
                                <DataGrid x:Name="ScanResultsGrid" Grid.Row="1" 
                                          Background="Transparent" Foreground="White" 
                                          BorderThickness="0" GridLinesVisibility="Horizontal" 
                                          HorizontalGridLinesBrush="#444" RowBackground="#2A2A2A" 
                                          AlternatingRowBackground="#333" HeadersVisibility="Column"
                                          AutoGenerateColumns="False" IsReadOnly="True" 
                                          CanUserResizeRows="False" CanUserSortColumns="True">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="File Name" Binding="{Binding FileName}" Width="200"/>
                                        <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="100"/>
                                        <DataGridTextColumn Header="Detection" Binding="{Binding DetectionRatio}" Width="100"/>
                                        <DataGridTextColumn Header="Threats" Binding="{Binding ThreatNamesFormatted}" Width="300"/>
                                        <DataGridTextColumn Header="Size" Binding="{Binding FileSizeFormatted}" Width="80"/>
                                        <DataGridTextColumn Header="Path" Binding="{Binding FilePath}" Width="*"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                        </Border>
                        
                        <!-- Scan Summary -->
                        <Border Grid.Row="3" Background="#2A2A2A" CornerRadius="6" Margin="40,0,40,40" Padding="20,15">
                            <Grid x:Name="ScanSummaryGrid" Visibility="Collapsed">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                
                                <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                                    <TextBlock x:Name="TotalFilesText" Text="0" FontSize="24" FontWeight="Bold" 
                                               Foreground="White" HorizontalAlignment="Center"/>
                                    <TextBlock Text="Total Files" FontSize="12" Foreground="#AAA" HorizontalAlignment="Center"/>
                                </StackPanel>
                                
                                <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                                    <TextBlock x:Name="CleanFilesText" Text="0" FontSize="24" FontWeight="Bold" 
                                               Foreground="#4CAF50" HorizontalAlignment="Center"/>
                                    <TextBlock Text="Clean" FontSize="12" Foreground="#AAA" HorizontalAlignment="Center"/>
                                </StackPanel>
                                
                                <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                                    <TextBlock x:Name="SuspiciousFilesText" Text="0" FontSize="24" FontWeight="Bold" 
                                               Foreground="#FF9800" HorizontalAlignment="Center"/>
                                    <TextBlock Text="Suspicious" FontSize="12" Foreground="#AAA" HorizontalAlignment="Center"/>
                                </StackPanel>
                                
                                <StackPanel Grid.Column="3" HorizontalAlignment="Center">
                                    <TextBlock x:Name="MaliciousFilesText" Text="0" FontSize="24" FontWeight="Bold" 
                                               Foreground="#F44336" HorizontalAlignment="Center"/>
                                    <TextBlock Text="Malicious" FontSize="12" Foreground="#AAA" HorizontalAlignment="Center"/>
                                </StackPanel>
                                
                                <StackPanel Grid.Column="4" HorizontalAlignment="Center">
                                    <TextBlock x:Name="ScanDurationText" Text="0s" FontSize="24" FontWeight="Bold" 
                                               Foreground="#2196F3" HorizontalAlignment="Center"/>
                                    <TextBlock Text="Duration" FontSize="12" Foreground="#AAA" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- Input Playground Page -->
                    <Grid x:Name="PlaygroundPage" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>    <!-- Header -->
                            <RowDefinition Height="Auto"/>    <!-- Controls -->
                            <RowDefinition Height="*"/>       <!-- Content -->
                        </Grid.RowDefinitions>
                        
                        <!-- Header -->
                        <TextBlock Grid.Row="0" Text="Input Playground" FontSize="28" FontWeight="Light" 
                                   Foreground="White" Margin="40,40,40,20"/>
                        
                        <!-- Controls -->
                        <Border Grid.Row="1" Background="#2A2A2A" CornerRadius="6" Margin="40,0,40,20" Padding="20,15">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Button x:Name="MonitoringToggle" Content="🎯 START MONITORING" 
                                        Style="{StaticResource ModernButtonStyle}" 
                                        Click="MonitoringToggle_Click" Margin="0,0,20,0" Padding="15,10"/>
                                <TextBlock x:Name="MonitoringStatus" Text="Global keyboard monitoring disabled" 
                                           Foreground="#888" VerticalAlignment="Center" FontSize="14"/>
                            </StackPanel>
                        </Border>
                        
                        <!-- Content Area -->
                        <Grid Grid.Row="2" Margin="40,0,40,40">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            
                            <!-- Text Input Area -->
                            <Border Grid.Column="0" Background="#2A2A2A" CornerRadius="6" Margin="0,0,10,0">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    
                                    <TextBlock Grid.Row="0" Text="Type here to test detection:" 
                                               Foreground="#CCC" Margin="20,20,20,10" FontSize="14"/>
                                    
                                    <TextBox x:Name="PlaygroundTextBox" Grid.Row="1" 
                                             Background="#3A3A3A" Foreground="White" BorderThickness="0"
                                             Padding="20" FontSize="14" TextWrapping="Wrap" AcceptsReturn="True"
                                             TextChanged="PlaygroundTextBox_TextChanged"/>
                                </Grid>
                            </Border>
                            
                            <!-- Capture History -->
                            <Border Grid.Column="1" Background="#2A2A2A" CornerRadius="6" Margin="10,0,0,0">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    
                                    <TextBlock Grid.Row="0" Text="Global Capture History:" 
                                               Foreground="#CCC" Margin="20,20,20,10" FontSize="14"/>
                                    
                                    <ListView x:Name="CaptureHistoryList" Grid.Row="1" 
                                              Background="Transparent" Foreground="#CCC" BorderThickness="0"
                                              Margin="20,0,20,20" FontFamily="Consolas" FontSize="12"/>
                                </Grid>
                            </Border>
                        </Grid>
                    </Grid>

                    <!-- Threat History Page -->
                    <Grid x:Name="HistoryPage" Visibility="Collapsed">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="📊 Threat History" FontSize="32" Foreground="White" HorizontalAlignment="Center"/>
                            <TextBlock Text="Coming Soon" FontSize="16" Foreground="#888" HorizontalAlignment="Center" Margin="0,10,0,0"/>
                        </StackPanel>
                    </Grid>

                    <!-- Settings Page -->
                    <Grid x:Name="SettingsPage" Visibility="Collapsed">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="⚙ Settings" FontSize="32" Foreground="White" HorizontalAlignment="Center"/>
                            <TextBlock Text="Coming Soon" FontSize="16" Foreground="#888" HorizontalAlignment="Center" Margin="0,10,0,0"/>
                        </StackPanel>
                    </Grid>

                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
