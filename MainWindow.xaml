<Window x:Class="KeyloggerDetector.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:KeyloggerDetector.Converters"
        Title="KeyGuard Pro - Advanced Keylogger Detection" 
        Height="800" Width="1200" MinHeight="600" MinWidth="900"
        WindowStartupLocation="CenterScreen"
        Background="#1E1E1E"
        ResizeMode="CanResize">
    
    <Window.Resources>
        <!-- Modern Dark Theme Resources -->
        
        <!-- Converters -->
        <local:StringToVisibilityConverter x:Key="StringToVisibilityConverter"/>
        <local:ThreatLevelToColorConverter x:Key="ThreatLevelToColorConverter"/>
        <local:ProcessCategoryToIconConverter x:Key="ProcessCategoryToIconConverter"/>
        <local:BoolToFontWeightConverter x:Key="BoolToFontWeightConverter"/>
        <local:BytesToMBConverter x:Key="BytesToMBConverter"/>
        <local:StatusBackgroundConverter x:Key="StatusBackgroundConverter"/>
        <local:StatusTextConverter x:Key="StatusTextConverter"/>
        <local:ThreatLevelBackgroundConverter x:Key="ThreatLevelBackgroundConverter"/>
        <local:BoolToIconConverter x:Key="BoolToIconConverter"/>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        
        <!-- Text Alignment Styles -->
        <Style x:Key="CenterAlignedTextBlock" TargetType="TextBlock">
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
        
        <Style x:Key="LeftAlignedTextBlock" TargetType="TextBlock">
            <Setter Property="TextAlignment" Value="Left"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>
        
        <Style x:Key="NavigationButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#CCCCCC"/>
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="Width" Value="50"/>
            <Setter Property="Height" Value="50"/>
            <Setter Property="Margin" Value="0,5"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" 
                                CornerRadius="8" BorderThickness="0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#3E3E42"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#FF4444"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ModernButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#FF4444"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="20,10"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" 
                                CornerRadius="6" BorderThickness="0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#FF6666"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#DD2222"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ThreatItemStyle" TargetType="ListViewItem">
            <Setter Property="Background" Value="#2A2A2A"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Margin" Value="0,2"/>
            <Setter Property="Padding" Value="15,10"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListViewItem">
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        
        <!-- DataGrid Header Style with Black Font -->
        <Style x:Key="BlackHeaderStyle" TargetType="DataGridColumnHeader">
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Background" Value="#E0E0E0"/>
            <Setter Property="BorderBrush" Value="#CCCCCC"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <!-- Main Layout Grid -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="40"/>   <!-- Title Bar -->
            <RowDefinition Height="*"/>    <!-- Main Content -->
        </Grid.RowDefinitions>

        <!-- Custom Title Bar -->
        <Border Grid.Row="0" Background="#2D2D30" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="15,0">
                    <TextBlock Text="🛡️" FontSize="16" Foreground="#FF4444" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <TextBlock Text="KeyGuard Pro" FontSize="14" FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center"/>
                    <TextBlock Text="v1.0" FontSize="11" Foreground="#888" VerticalAlignment="Center" Margin="10,0,0,0"/>
                </StackPanel>
                
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="—" Click="MinimizeButton_Click" Width="45" Height="30" Background="Transparent" 
                            Foreground="#CCC" BorderThickness="0" FontSize="16"/>
                    <Button Content="✕" Click="CloseButton_Click" Width="45" Height="30" Background="Transparent" 
                            Foreground="#CCC" BorderThickness="0" FontSize="14"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Content -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="80"/>    <!-- Navigation Sidebar -->
                <ColumnDefinition Width="*"/>     <!-- Main Content Area -->
            </Grid.ColumnDefinitions>

            <!-- Left Navigation Sidebar -->
            <Border Grid.Column="0">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#2D2D30" Offset="0"/>
                        <GradientStop Color="#1E1B2E" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                <StackPanel Margin="15,20" VerticalAlignment="Center">
                    <!-- Navigation Buttons -->
                    <Button x:Name="HomeNavBtn" Content="🏠" Style="{StaticResource NavigationButtonStyle}" 
                            Click="NavigateToHome" ToolTip="Home Dashboard"/>
                    <Button x:Name="ScannerNavBtn" Content="🔍" Style="{StaticResource NavigationButtonStyle}" 
                            Click="NavigateToScanner" ToolTip="File Scanner"/>
                    <Button x:Name="ProcessNavBtn" Content="⚙️" Style="{StaticResource NavigationButtonStyle}" 
                            Click="NavigateToProcesses" ToolTip="Process Monitor"/>
                    <Button x:Name="PlaygroundNavBtn" Content="🎮" Style="{StaticResource NavigationButtonStyle}" 
                            Click="NavigateToPlayground" ToolTip="Input Playground"/>
                </StackPanel>
            </Border>

            <!-- Main Content Frame -->
            <Border Grid.Column="1" Background="#1E1E1E">
                <Grid x:Name="MainContentGrid">
                    
                    <!-- Home Dashboard Page -->
                    <Grid x:Name="HomePage" Visibility="Visible">
                        <Grid.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#1E1B2E" Offset="0"/>
                                <GradientStop Color="#2A1F3D" Offset="1"/>
                            </LinearGradientBrush>
                        </Grid.Background>
                        
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>    <!-- Status Banner -->
                            <RowDefinition Height="*"/>       <!-- Feature Grid -->
                            <RowDefinition Height="Auto"/>    <!-- Footer -->
                        </Grid.RowDefinitions>
                        
                        <!-- Top Status Banner -->
                        <Border Grid.Row="0" Margin="30,30,30,20" CornerRadius="15" Height="120">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="#E91E63" Offset="0"/>
                                    <GradientStop Color="#F44336" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <Border.Effect>
                                <DropShadowEffect Color="#E91E63" BlurRadius="20" ShadowDepth="0" Opacity="0.6"/>
                            </Border.Effect>
                            
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                
                                <!-- Status Text -->
                                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="30,0">
                                    <TextBlock Text="YOU ARE SAFE" FontSize="32" FontWeight="Bold" Foreground="White" 
                                               FontFamily="Segoe UI"/>
                                    <TextBlock Text="Continuously guarding against threats to ensure your peace of mind" 
                                               FontSize="14" Foreground="#E8E8E8" Margin="0,5,0,0" FontFamily="Segoe UI"/>
                                </StackPanel>
                                
                                <!-- 3D Shield Icon -->
                                <Viewbox Grid.Column="1" Width="100" Height="100" Margin="20">
                                    <Canvas Width="100" Height="100">
                                        <!-- Shield Background -->
                                        <Ellipse Width="80" Height="80" Canvas.Left="10" Canvas.Top="10">
                                            <Ellipse.Fill>
                                                <RadialGradientBrush>
                                                    <GradientStop Color="#4FC3F7" Offset="0"/>
                                                    <GradientStop Color="#29B6F6" Offset="1"/>
                                                </RadialGradientBrush>
                                            </Ellipse.Fill>
                                            <Ellipse.Effect>
                                                <DropShadowEffect Color="#29B6F6" BlurRadius="15" ShadowDepth="0" Opacity="0.8"/>
                                            </Ellipse.Effect>
                                        </Ellipse>
                                        <!-- Shield Icon -->
                                        <Path Data="M50,20 L35,30 L35,55 L50,70 L65,55 L65,30 Z" Fill="White" Stroke="White" StrokeThickness="2"/>
                                        <!-- Sword -->
                                        <Rectangle Width="3" Height="40" Canvas.Left="48.5" Canvas.Top="25" Fill="White"/>
                                        <Ellipse Width="8" Height="8" Canvas.Left="46" Canvas.Top="22" Fill="White"/>
                                    </Canvas>
                                </Viewbox>
                            </Grid>
                        </Border>
                        
                        <!-- Feature Grid -->
                        <Grid Grid.Row="1" Margin="30,0,30,20">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            
                            <!-- File Scanner Card -->
                            <Border Grid.Row="0" Grid.Column="0" Margin="10" CornerRadius="15" 
                                    Background="#2A2A2A" BorderBrush="#E91E63" BorderThickness="1"
                                    Cursor="Hand">
                                <Border.Effect>
                                    <DropShadowEffect Color="#E91E63" BlurRadius="10" ShadowDepth="0" Opacity="0.3"/>
                                </Border.Effect>
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
                                        <Setter Property="RenderTransform">
                                            <Setter.Value>
                                                <ScaleTransform ScaleX="1" ScaleY="1"/>
                                            </Setter.Value>
                                        </Setter>
                                        <Style.Triggers>
                                            <EventTrigger RoutedEvent="MouseEnter">
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <DoubleAnimation 
                                                            Storyboard.TargetProperty="RenderTransform.ScaleX" 
                                                            To="1.04" Duration="0:0:0.2"/>
                                                        <DoubleAnimation 
                                                            Storyboard.TargetProperty="RenderTransform.ScaleY" 
                                                            To="1.04" Duration="0:0:0.2"/>
                                                        <DoubleAnimation 
                                                            Storyboard.TargetProperty="Effect.Opacity" 
                                                            To="0.6" Duration="0:0:0.2"/>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </EventTrigger>
                                            <EventTrigger RoutedEvent="MouseLeave">
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <DoubleAnimation 
                                                            Storyboard.TargetProperty="RenderTransform.ScaleX" 
                                                            To="1.0" Duration="0:0:0.2"/>
                                                        <DoubleAnimation 
                                                            Storyboard.TargetProperty="RenderTransform.ScaleY" 
                                                            To="1.0" Duration="0:0:0.2"/>
                                                        <DoubleAnimation 
                                                            Storyboard.TargetProperty="Effect.Opacity" 
                                                            To="0.3" Duration="0:0:0.2"/>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </EventTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Button x:Name="FileScannerCard" Background="Transparent" BorderThickness="0" 
                                        Click="NavigateToScanner" Cursor="Hand">
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Setter Property="Background" Value="Transparent"/>
                                            <Setter Property="BorderThickness" Value="0"/>
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border Background="{TemplateBinding Background}" 
                                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                                BorderThickness="{TemplateBinding BorderThickness}">
                                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Border>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </Button.Style>
                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="20">
                                        <!-- Magnifying Glass Icon -->
                                        <Viewbox Width="50" Height="50" Margin="0,0,0,15">
                                            <Canvas Width="50" Height="50">
                                                <Ellipse Width="30" Height="30" Canvas.Left="5" Canvas.Top="5" 
                                                         Stroke="White" StrokeThickness="3" Fill="Transparent"/>
                                                <Line X1="30" Y1="30" X2="45" Y2="45" Stroke="White" StrokeThickness="3"/>
                                            </Canvas>
                                        </Viewbox>
                                        <TextBlock Text="FILE SCANNER" FontSize="16" FontWeight="Bold" 
                                                   Foreground="White" HorizontalAlignment="Center" FontFamily="Segoe UI"/>
                                        <TextBlock Text="Scan files and folders for threats" FontSize="11" 
                                                   Foreground="#CCCCCC" HorizontalAlignment="Center" 
                                                   Margin="0,5,0,0" TextWrapping="Wrap" FontFamily="Segoe UI"/>
                                    </StackPanel>
                                </Button>
                            </Border>
                            
                            <!-- Process Monitor Card -->
                            <Border Grid.Row="0" Grid.Column="1" Margin="10" CornerRadius="15" 
                                    Background="#2A2A2A" BorderBrush="#E91E63" BorderThickness="1"
                                    Cursor="Hand" RenderTransformOrigin="0.5,0.5">
                                <Border.RenderTransform>
                                    <ScaleTransform x:Name="ProcessMonitorScale" ScaleX="1" ScaleY="1"/>
                                </Border.RenderTransform>
                                <Border.Effect>
                                    <DropShadowEffect x:Name="ProcessMonitorGlow" Color="#E91E63" BlurRadius="10" ShadowDepth="0" Opacity="0.3"/>
                                </Border.Effect>
                                <Border.Triggers>
                                    <EventTrigger RoutedEvent="MouseEnter">
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetProperty="(Border.RenderTransform).(ScaleTransform.ScaleX)" 
                                                               To="1.04" Duration="0:0:0.2"/>
                                                <DoubleAnimation Storyboard.TargetProperty="(Border.RenderTransform).(ScaleTransform.ScaleY)" 
                                                               To="1.04" Duration="0:0:0.2"/>
                                                <DoubleAnimation Storyboard.TargetProperty="(Border.Effect).(DropShadowEffect.Opacity)" 
                                                               To="0.6" Duration="0:0:0.2"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </EventTrigger>
                                    <EventTrigger RoutedEvent="MouseLeave">
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetProperty="(Border.RenderTransform).(ScaleTransform.ScaleX)" 
                                                               To="1" Duration="0:0:0.2"/>
                                                <DoubleAnimation Storyboard.TargetProperty="(Border.RenderTransform).(ScaleTransform.ScaleY)" 
                                                               To="1" Duration="0:0:0.2"/>
                                                <DoubleAnimation Storyboard.TargetProperty="(Border.Effect).(DropShadowEffect.Opacity)" 
                                                               To="0.3" Duration="0:0:0.2"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </EventTrigger>
                                </Border.Triggers>
                                <Button x:Name="ProcessMonitorCard" Background="Transparent" BorderThickness="0" 
                                        Click="NavigateToProcesses" Cursor="Hand">
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Setter Property="Background" Value="Transparent"/>
                                            <Setter Property="BorderThickness" Value="0"/>
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border Background="{TemplateBinding Background}" 
                                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                                BorderThickness="{TemplateBinding BorderThickness}">
                                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Border>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </Button.Style>
                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="20">
                                        <!-- Process/Gear Icon -->
                                        <Viewbox Width="50" Height="50" Margin="0,0,0,15">
                                            <Canvas Width="50" Height="50">
                                                <Ellipse Width="40" Height="40" Canvas.Left="5" Canvas.Top="5" 
                                                         Stroke="White" StrokeThickness="3" Fill="Transparent"/>
                                                <Ellipse Width="15" Height="15" Canvas.Left="17.5" Canvas.Top="17.5" 
                                                         Stroke="White" StrokeThickness="2" Fill="Transparent"/>
                                                <!-- Gear teeth -->
                                                <Rectangle Width="6" Height="3" Canvas.Left="22" Canvas.Top="2" Fill="White"/>
                                                <Rectangle Width="6" Height="3" Canvas.Left="22" Canvas.Top="45" Fill="White"/>
                                                <Rectangle Width="3" Height="6" Canvas.Left="2" Canvas.Top="22" Fill="White"/>
                                                <Rectangle Width="3" Height="6" Canvas.Left="45" Canvas.Top="22" Fill="White"/>
                                            </Canvas>
                                        </Viewbox>
                                        <TextBlock Text="PROCESS MONITOR" FontSize="16" FontWeight="Bold" 
                                                   Foreground="White" HorizontalAlignment="Center" FontFamily="Segoe UI"/>
                                        <TextBlock Text="Monitor running processes and threats" FontSize="11" 
                                                   Foreground="#CCCCCC" HorizontalAlignment="Center" 
                                                   Margin="0,5,0,0" TextWrapping="Wrap" FontFamily="Segoe UI"/>
                                    </StackPanel>
                                </Button>
                            </Border>
                            
                            <!-- Input Playground Card -->
                            <Border Grid.Row="0" Grid.Column="2" Margin="10" CornerRadius="15" 
                                    Background="#2A2A2A" BorderBrush="#E91E63" BorderThickness="1"
                                    Cursor="Hand" RenderTransformOrigin="0.5,0.5">
                                <Border.RenderTransform>
                                    <ScaleTransform x:Name="PlaygroundScale" ScaleX="1" ScaleY="1"/>
                                </Border.RenderTransform>
                                <Border.Effect>
                                    <DropShadowEffect x:Name="PlaygroundGlow" Color="#E91E63" BlurRadius="10" ShadowDepth="0" Opacity="0.3"/>
                                </Border.Effect>
                                <Border.Triggers>
                                    <EventTrigger RoutedEvent="MouseEnter">
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetProperty="(Border.RenderTransform).(ScaleTransform.ScaleX)" 
                                                               To="1.04" Duration="0:0:0.2"/>
                                                <DoubleAnimation Storyboard.TargetProperty="(Border.RenderTransform).(ScaleTransform.ScaleY)" 
                                                               To="1.04" Duration="0:0:0.2"/>
                                                <DoubleAnimation Storyboard.TargetProperty="(Border.Effect).(DropShadowEffect.Opacity)" 
                                                               To="0.6" Duration="0:0:0.2"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </EventTrigger>
                                    <EventTrigger RoutedEvent="MouseLeave">
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetProperty="(Border.RenderTransform).(ScaleTransform.ScaleX)" 
                                                               To="1" Duration="0:0:0.2"/>
                                                <DoubleAnimation Storyboard.TargetProperty="(Border.RenderTransform).(ScaleTransform.ScaleY)" 
                                                               To="1" Duration="0:0:0.2"/>
                                                <DoubleAnimation Storyboard.TargetProperty="(Border.Effect).(DropShadowEffect.Opacity)" 
                                                               To="0.3" Duration="0:0:0.2"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </EventTrigger>
                                </Border.Triggers>
                                <Button x:Name="PlaygroundCard" Background="Transparent" BorderThickness="0" 
                                        Click="NavigateToPlayground" Cursor="Hand">
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Setter Property="Background" Value="Transparent"/>
                                            <Setter Property="BorderThickness" Value="0"/>
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border Background="{TemplateBinding Background}" 
                                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                                BorderThickness="{TemplateBinding BorderThickness}">
                                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Border>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </Button.Style>
                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="20">
                                        <!-- Gaming Controller Icon -->
                                        <Viewbox Width="50" Height="50" Margin="0,0,0,15">
                                            <Canvas Width="50" Height="50">
                                                <!-- Controller body -->
                                                <Rectangle Width="35" Height="20" Canvas.Left="7.5" Canvas.Top="15" 
                                                          Stroke="White" StrokeThickness="3" Fill="Transparent" RadiusX="10" RadiusY="10"/>
                                                <!-- D-pad -->
                                                <Rectangle Width="3" Height="8" Canvas.Left="15" Canvas.Top="21" Fill="White"/>
                                                <Rectangle Width="8" Height="3" Canvas.Left="12.5" Canvas.Top="23.5" Fill="White"/>
                                                <!-- Buttons -->
                                                <Ellipse Width="4" Height="4" Canvas.Left="32" Canvas.Top="20" Fill="White"/>
                                                <Ellipse Width="4" Height="4" Canvas.Left="32" Canvas.Top="27" Fill="White"/>
                                            </Canvas>
                                        </Viewbox>
                                        <TextBlock Text="INPUT PLAYGROUND" FontSize="16" FontWeight="Bold" 
                                                   Foreground="White" HorizontalAlignment="Center" FontFamily="Segoe UI"/>
                                        <TextBlock Text="Global keyboard monitoring and testing" FontSize="11" 
                                                   Foreground="#CCCCCC" HorizontalAlignment="Center" 
                                                   Margin="0,5,0,0" TextWrapping="Wrap" FontFamily="Segoe UI"/>
                                    </StackPanel>
                                </Button>
                            </Border>
                            
                            <!-- Additional feature placeholders for future -->
                            <Border Grid.Row="1" Grid.Column="0" Margin="10" CornerRadius="15" 
                                    Background="#1A1A1A" BorderBrush="#555555" BorderThickness="1" Opacity="0.6">
                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="20">
                                    <Viewbox Width="40" Height="40" Margin="0,0,0,15">
                                        <Canvas Width="40" Height="40">
                                            <Ellipse Width="30" Height="30" Canvas.Left="5" Canvas.Top="5" 
                                                     Stroke="#666666" StrokeThickness="2" Fill="Transparent"/>
                                        </Canvas>
                                    </Viewbox>
                                    <TextBlock Text="FIREWALL" FontSize="14" FontWeight="Bold" 
                                               Foreground="#666666" HorizontalAlignment="Center" FontFamily="Segoe UI"/>
                                    <TextBlock Text="Coming Soon" FontSize="10" 
                                               Foreground="#555555" HorizontalAlignment="Center" 
                                               Margin="0,5,0,0" FontFamily="Segoe UI"/>
                                </StackPanel>
                            </Border>
                            
                            <Border Grid.Row="1" Grid.Column="1" Margin="10" CornerRadius="15" 
                                    Background="#1A1A1A" BorderBrush="#555555" BorderThickness="1" Opacity="0.6">
                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="20">
                                    <Viewbox Width="40" Height="40" Margin="0,0,0,15">
                                        <Canvas Width="40" Height="40">
                                            <Rectangle Width="25" Height="20" Canvas.Left="7.5" Canvas.Top="10" 
                                                      Stroke="#666666" StrokeThickness="2" Fill="Transparent" RadiusX="3" RadiusY="3"/>
                                        </Canvas>
                                    </Viewbox>
                                    <TextBlock Text="SAFE BROWSER" FontSize="14" FontWeight="Bold" 
                                               Foreground="#666666" HorizontalAlignment="Center" FontFamily="Segoe UI"/>
                                    <TextBlock Text="Coming Soon" FontSize="10" 
                                               Foreground="#555555" HorizontalAlignment="Center" 
                                               Margin="0,5,0,0" FontFamily="Segoe UI"/>
                                </StackPanel>
                            </Border>
                            
                            <Border Grid.Row="1" Grid.Column="2" Margin="10" CornerRadius="15" 
                                    Background="#1A1A1A" BorderBrush="#555555" BorderThickness="1" Opacity="0.6">
                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="20">
                                    <Viewbox Width="40" Height="40" Margin="0,0,0,15">
                                        <Canvas Width="40" Height="40">
                                            <Rectangle Width="20" Height="30" Canvas.Left="10" Canvas.Top="5" 
                                                      Stroke="#666666" StrokeThickness="2" Fill="Transparent" RadiusX="5" RadiusY="5"/>
                                        </Canvas>
                                    </Viewbox>
                                    <TextBlock Text="DEVICE SECURITY" FontSize="14" FontWeight="Bold" 
                                               Foreground="#666666" HorizontalAlignment="Center" FontFamily="Segoe UI"/>
                                    <TextBlock Text="Coming Soon" FontSize="10" 
                                               Foreground="#555555" HorizontalAlignment="Center" 
                                               Margin="0,5,0,0" FontFamily="Segoe UI"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                        
                        <!-- Footer Text -->
                        <TextBlock Grid.Row="2" Text="KeyGuard Pro - Advanced Cybersecurity Protection" 
                                   Foreground="#888888" FontSize="12" HorizontalAlignment="Center" 
                                   Margin="0,0,0,20" FontFamily="Segoe UI"/>
                    </Grid>
                    
                    <!-- Process Monitor Page -->
                    <Grid x:Name="ProcessMonitorPage" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>    <!-- Header -->
                            <RowDefinition Height="Auto"/>    <!-- Controls -->
                            <RowDefinition Height="Auto"/>    <!-- Tab Headers -->
                            <RowDefinition Height="*"/>       <!-- Process List -->
                        </Grid.RowDefinitions>
                        
                        <!-- Header Section -->
                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="30,30,30,20">
                            <TextBlock Text="🔄" FontSize="24" Foreground="#FF4444" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <TextBlock Text="Process Monitor" FontSize="28" FontWeight="Light" 
                                       Foreground="White" VerticalAlignment="Center"/>
                            <TextBlock x:Name="ProcessCountLabel" Text="Loading..." 
                                       Foreground="#AAAAAA" FontSize="14" VerticalAlignment="Center" Margin="20,0,0,0"/>
                            <TextBlock x:Name="ProcessStatusText" Text="" 
                                       Foreground="#888" FontSize="12" VerticalAlignment="Center" Margin="15,0,0,0"/>
                        </StackPanel>
                        
                        <!-- Controls Section -->
                        <Border Grid.Row="1" Background="#2A2A2A" CornerRadius="6" Margin="30,0,30,15" Padding="20,12">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                
                                <!-- Top Row - Main Controls -->
                                <Grid Grid.Row="0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    
                                    <TextBox x:Name="ProcessSearchBox" Grid.Column="0" Height="36" 
                                             Background="#3A3A3A" Foreground="White" BorderBrush="#555" BorderThickness="1"
                                             Padding="12,8" FontSize="14" VerticalContentAlignment="Center"
                                             Text="Search processes..." TextChanged="ProcessSearchBox_TextChanged"
                                             GotFocus="ProcessSearchBox_GotFocus" LostFocus="ProcessSearchBox_LostFocus"
                                             ToolTip="Filter by process name, PID, or threat level" Margin="0,0,15,0"/>
                                    
                                    <Button Grid.Column="1" x:Name="EndTaskButton" Content="⚠️ End Task" 
                                            Background="#DC2626" Foreground="White" BorderThickness="0" 
                                            Padding="12,8" FontSize="12" FontWeight="SemiBold" Margin="15,0,0,0"
                                            Click="TerminateSelectedProcess_Click" IsEnabled="False"
                                            ToolTip="Terminate selected process">
                                        <Button.Style>
                                            <Style TargetType="Button">
                                                <Setter Property="Background" Value="#DC2626"/>
                                                <Setter Property="Foreground" Value="White"/>
                                                <Setter Property="BorderThickness" Value="0"/>
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border Background="{TemplateBinding Background}" 
                                                                    CornerRadius="4" Padding="{TemplateBinding Padding}">
                                                                <ContentPresenter HorizontalAlignment="Center" 
                                                                                VerticalAlignment="Center"/>
                                                            </Border>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                                <Style.Triggers>
                                                    <Trigger Property="IsEnabled" Value="False">
                                                        <Setter Property="Background" Value="#6B7280"/>
                                                        <Setter Property="Foreground" Value="#9CA3AF"/>
                                                    </Trigger>
                                                    <Trigger Property="IsEnabled" Value="True">
                                                        <Setter Property="Background" Value="#DC2626"/>
                                                        <Setter Property="Foreground" Value="White"/>
                                                    </Trigger>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="#B91C1C"/>
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                </Grid>
                                
                                <!-- Bottom Row - Filters and Controls -->
                                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,10,0,0">
                                    <TextBlock Text="Filter:" Foreground="#CCC" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                    
                                    <ComboBox x:Name="ThreatLevelFilter" Width="120" Margin="0,0,10,0"
                                              Background="#3A3A3A" BorderBrush="#555"
                                              SelectionChanged="ThreatLevelFilter_Changed">
                                        <ComboBox.Style>
                                            <Style TargetType="ComboBox">
                                                <Setter Property="Foreground" Value="Black"/>
                                                <Setter Property="Background" Value="#F5F5F5"/>
                                                <Setter Property="BorderBrush" Value="#555"/>
                                                <Setter Property="BorderThickness" Value="1"/>
                                                <Setter Property="Padding" Value="8,4"/>
                                                <Setter Property="FontSize" Value="12"/>
                                            </Style>
                                        </ComboBox.Style>
                                        <ComboBox.ItemContainerStyle>
                                            <Style TargetType="ComboBoxItem">
                                                <Setter Property="Foreground" Value="Black"/>
                                                <Setter Property="Background" Value="White"/>
                                                <Setter Property="Padding" Value="8,4"/>
                                            </Style>
                                        </ComboBox.ItemContainerStyle>
                                        <ComboBoxItem Content="All Threats" IsSelected="True"/>
                                        <ComboBoxItem Content="Critical"/>
                                        <ComboBoxItem Content="High"/>
                                        <ComboBoxItem Content="Medium"/>
                                        <ComboBoxItem Content="Low"/>
                                        <ComboBoxItem Content="Safe"/>
                                    </ComboBox>
                                    
                                    <ComboBox x:Name="ProcessTypeFilter" Width="150" Margin="0,0,10,0"
                                              Background="#3A3A3A" BorderBrush="#555"
                                              SelectionChanged="ProcessTypeFilter_Changed">
                                        <ComboBox.Style>
                                            <Style TargetType="ComboBox">
                                                <Setter Property="Foreground" Value="Black"/>
                                                <Setter Property="Background" Value="#F5F5F5"/>
                                                <Setter Property="BorderBrush" Value="#555"/>
                                                <Setter Property="BorderThickness" Value="1"/>
                                                <Setter Property="Padding" Value="8,4"/>
                                                <Setter Property="FontSize" Value="12"/>
                                            </Style>
                                        </ComboBox.Style>
                                        <ComboBox.ItemContainerStyle>
                                            <Style TargetType="ComboBoxItem">
                                                <Setter Property="Foreground" Value="Black"/>
                                                <Setter Property="Background" Value="White"/>
                                                <Setter Property="Padding" Value="8,4"/>
                                            </Style>
                                        </ComboBox.ItemContainerStyle>
                                        <ComboBoxItem Content="All Processes" IsSelected="True"/>
                                        <ComboBoxItem Content="System Applications"/>
                                        <ComboBoxItem Content="User Applications"/>
                                        <ComboBoxItem Content="Unknown/Suspicious"/>
                                    </ComboBox>
                                    
                                    <!-- Show System Checkbox -->
                                    <CheckBox x:Name="ShowSystemCheckBox" Content="Show System" 
                                              Foreground="#CCC" Margin="15,0,15,0" IsChecked="True"
                                              Checked="ShowSystemCheckBox_Changed" Unchecked="ShowSystemCheckBox_Changed"
                                              VerticalAlignment="Center"/>
                                    
                                    <!-- Auto Refresh Checkbox -->
                                    <CheckBox x:Name="AutoRefreshCheckBox" Content="Auto Refresh" 
                                              Foreground="#CCC" Margin="0,0,10,0" IsChecked="True"
                                              Checked="AutoRefreshCheckBox_Changed" Unchecked="AutoRefreshCheckBox_Changed"
                                              VerticalAlignment="Center"/>
                                    
                                    <!-- Refresh Interval -->
                                    <TextBlock Text="(every" Foreground="#888" VerticalAlignment="Center" Margin="5,0,5,0"/>
                                    <TextBox x:Name="RefreshIntervalTextBox" Width="30" Height="25" 
                                             Background="#3A3A3A" Foreground="White" BorderBrush="#555" BorderThickness="1"
                                             Text="3" TextAlignment="Center" VerticalContentAlignment="Center"
                                             FontSize="11"/>
                                    <TextBlock Text="sec)" Foreground="#888" VerticalAlignment="Center" Margin="5,0,0,0"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                        
                        <!-- All Processes Header -->
                        <Border Grid.Row="2" Background="#363636" Margin="30,0,30,0" 
                                BorderThickness="0,0,0,1" BorderBrush="#555">
                            <StackPanel Orientation="Horizontal" Margin="20,8,20,8">
                                <TextBlock Text="All Processes &amp; Services" FontSize="14" FontWeight="SemiBold" 
                                          Foreground="White" VerticalAlignment="Center"/>
                                <TextBlock x:Name="ProcessCountText" Text="(Loading...)" FontSize="13" 
                                          Foreground="#CCC" VerticalAlignment="Center" Margin="10,0,0,0"/>
                            </StackPanel>
                        </Border>
                        
                        <!-- Process List Section (Modern Task Manager Style) -->
                        <Border Grid.Row="3" Background="#2A2A2A" Margin="30,0,30,30" CornerRadius="8">
                            <DataGrid x:Name="ProcessDataGrid" 
                                      Background="Transparent" Foreground="White" 
                                      BorderThickness="0" GridLinesVisibility="Horizontal" 
                                      HorizontalGridLinesBrush="#404040" RowBackground="#2A2A2A" 
                                      AlternatingRowBackground="#333333" HeadersVisibility="Column"
                                      AutoGenerateColumns="False" IsReadOnly="True" 
                                      CanUserResizeRows="False" CanUserSortColumns="True"
                                      SelectionMode="Single" SelectionChanged="ProcessDataGrid_SelectionChanged"
                                      RowHeight="48" FontSize="13" Margin="1">
                                
                                <!-- Modern DataGrid Styles -->
                                <DataGrid.Resources>
                                    <Style TargetType="DataGridColumnHeader">
                                        <Setter Property="Background" Value="#404040"/>
                                        <Setter Property="Foreground" Value="White"/>
                                        <Setter Property="BorderBrush" Value="#555"/>
                                        <Setter Property="BorderThickness" Value="0,0,1,2"/>
                                        <Setter Property="Padding" Value="16,12"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                        <Setter Property="FontSize" Value="13"/>
                                        <Setter Property="HorizontalContentAlignment" Value="Left"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="DataGridColumnHeader">
                                                    <Border Background="{TemplateBinding Background}" 
                                                            BorderBrush="{TemplateBinding BorderBrush}"
                                                            BorderThickness="{TemplateBinding BorderThickness}"
                                                            Padding="{TemplateBinding Padding}">
                                                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                                        VerticalAlignment="Center"/>
                                                    </Border>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                    
                                    <Style TargetType="DataGridRow">
                                        <Setter Property="Background" Value="#2A2A2A"/>
                                        <Setter Property="BorderThickness" Value="0"/>
                                        <Setter Property="Margin" Value="0,1"/>
                                        <Setter Property="Height" Value="48"/>
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#3A3A3A"/>
                                                <Setter Property="BorderBrush" Value="#555"/>
                                                <Setter Property="BorderThickness" Value="1"/>
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter Property="Background" Value="#1976D2"/>
                                                <Setter Property="Foreground" Value="White"/>
                                                <Setter Property="BorderBrush" Value="#0D47A1"/>
                                                <Setter Property="BorderThickness" Value="3"/>
                                            </Trigger>
                                            <MultiTrigger>
                                                <MultiTrigger.Conditions>
                                                    <Condition Property="IsSelected" Value="True"/>
                                                    <Condition Property="IsMouseOver" Value="True"/>
                                                </MultiTrigger.Conditions>
                                                <Setter Property="Background" Value="#1565C0"/>
                                                <Setter Property="BorderBrush" Value="#0D47A1"/>
                                                <Setter Property="BorderThickness" Value="3"/>
                                            </MultiTrigger>
                                        </Style.Triggers>
                                    </Style>
                                    
                                    <Style TargetType="DataGridCell">
                                        <Setter Property="BorderThickness" Value="0"/>
                                        <Setter Property="Padding" Value="0"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="DataGridCell">
                                                    <Border Background="{TemplateBinding Background}" 
                                                            BorderBrush="{TemplateBinding BorderBrush}"
                                                            BorderThickness="{TemplateBinding BorderThickness}"
                                                            Padding="{TemplateBinding Padding}">
                                                        <ContentPresenter VerticalAlignment="Center"/>
                                                    </Border>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                        <Style.Triggers>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter Property="Background" Value="Transparent"/>
                                                <Setter Property="Foreground" Value="White"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </DataGrid.Resources>
                                
                                <DataGrid.Columns>
                                    <!-- Process Name Column with Icon -->
                                    <DataGridTemplateColumn Header="Process Name" Width="*" SortMemberPath="Name">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="12,8">
                                                    <TextBlock Text="📋" FontSize="16" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding Name}" 
                                                                   FontSize="14" Foreground="White" FontWeight="Medium"/>
                                                        <TextBlock Text="{Binding Description}" 
                                                                   FontSize="11" Foreground="#888" TextTrimming="CharacterEllipsis"/>
                                                    </StackPanel>
                                                </StackPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    
                                    <!-- PID Column -->
                                    <DataGridTextColumn Header="PID" Width="100" 
                                                        Binding="{Binding Id}" 
                                                        ElementStyle="{StaticResource CenterAlignedTextBlock}"/>
                                    
                                    <!-- Status Column -->
                                    <DataGridTemplateColumn Header="Status" Width="120" SortMemberPath="ThreatLevel">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0">
                                                    <Ellipse Width="10" Height="10" Margin="0,0,8,0">
                                                        <Ellipse.Fill>
                                                            <SolidColorBrush Color="{Binding ThreatLevel, Converter={StaticResource ThreatLevelToColorConverter}}"/>
                                                        </Ellipse.Fill>
                                                    </Ellipse>
                                                    <TextBlock Text="{Binding ThreatLevel}" 
                                                               FontSize="13" Foreground="#E5E5E5" FontWeight="Medium"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    
                                    <!-- Actions Column -->
                                    <DataGridTemplateColumn Header="Actions" Width="180">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal" Margin="8,4">
                                                    <Button Content="🔍 Details" Background="#0078D4" Foreground="White" 
                                                            BorderThickness="0" Padding="10,6" FontSize="12" Margin="0,0,8,0"
                                                            Click="InspectProcess_Click" CommandParameter="{Binding}"
                                                            ToolTip="View process details" FontWeight="Medium"
                                                            Height="32" MinWidth="70">
                                                        <Button.Style>
                                                            <Style TargetType="Button">
                                                                <Setter Property="Background" Value="#0078D4"/>
                                                                <Setter Property="Template">
                                                                    <Setter.Value>
                                                                        <ControlTemplate TargetType="Button">
                                                                            <Border Background="{TemplateBinding Background}" 
                                                                                    CornerRadius="4" Padding="{TemplateBinding Padding}">
                                                                                <ContentPresenter HorizontalAlignment="Center" 
                                                                                                VerticalAlignment="Center"/>
                                                                            </Border>
                                                                        </ControlTemplate>
                                                                    </Setter.Value>
                                                                </Setter>
                                                                <Style.Triggers>
                                                                    <Trigger Property="IsMouseOver" Value="True">
                                                                        <Setter Property="Background" Value="#106EBE"/>
                                                                    </Trigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Button.Style>
                                                    </Button>
                                                    <Button Content="⚠️ End Task" Background="#DC2626" Foreground="White" 
                                                            BorderThickness="0" Padding="10,6" FontSize="12"
                                                            Click="TerminateProcess_Click" CommandParameter="{Binding}"
                                                            ToolTip="Terminate this process" FontWeight="Medium"
                                                            Height="32" MinWidth="80">
                                                        <Button.Style>
                                                            <Style TargetType="Button">
                                                                <Setter Property="Background" Value="#DC2626"/>
                                                                <Setter Property="Template">
                                                                    <Setter.Value>
                                                                        <ControlTemplate TargetType="Button">
                                                                            <Border Background="{TemplateBinding Background}" 
                                                                                    CornerRadius="4" Padding="{TemplateBinding Padding}">
                                                                                <ContentPresenter HorizontalAlignment="Center" 
                                                                                                VerticalAlignment="Center"/>
                                                                            </Border>
                                                                        </ControlTemplate>
                                                                    </Setter.Value>
                                                                </Setter>
                                                                <Style.Triggers>
                                                                    <Trigger Property="IsMouseOver" Value="True">
                                                                        <Setter Property="Background" Value="#B91C1C"/>
                                                                    </Trigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Button.Style>
                                                    </Button>
                                                </StackPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Border>
                    </Grid>

                    <!-- File Scanner Page -->
                    <Grid x:Name="ScannerPage" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>   <!-- Header -->
                            <RowDefinition Height="Auto"/>   <!-- Controls -->
                            <RowDefinition Height="*"/>      <!-- Results -->
                            <RowDefinition Height="Auto"/>   <!-- Summary -->
                        </Grid.RowDefinitions>
                        
                        <!-- Header -->
                        <StackPanel Grid.Row="0" Margin="40,40,40,20">
                            <TextBlock Text="File Scanner" FontSize="28" FontWeight="Light" 
                                       Foreground="White" HorizontalAlignment="Left"/>
                            <TextBlock x:Name="ScannerStatusText" Text="Hybrid Analysis: Real-time + VirusTotal" FontSize="14" 
                                       Foreground="#888" HorizontalAlignment="Left" Margin="0,5,0,0"/>
                        </StackPanel>
                        
                        <!-- Scan Controls -->
                        <Border Grid.Row="1" Background="#2A2A2A" CornerRadius="6" Margin="40,0,40,20" Padding="25,20">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                
                                <!-- Folder Selection -->
                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button x:Name="SelectFolderButton" Content="📁 SELECT FOLDER" 
                                            Style="{StaticResource ModernButtonStyle}" 
                                            Click="SelectFolderButton_Click" Margin="0,0,20,0" 
                                            Padding="25,15" FontSize="16" FontWeight="Bold"
                                            Width="200" Height="50"/>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="Selected Folder:" Foreground="#888" FontSize="12" Margin="0,0,0,3"/>
                                        <TextBlock x:Name="SelectedFolderText" Text="No folder selected" 
                                                   Foreground="#CCC" FontSize="14" FontWeight="Medium"
                                                   TextTrimming="CharacterEllipsis" MaxWidth="350"/>
                                    </StackPanel>
                                </StackPanel>
                                
                                <!-- Scan Options -->
                                <StackPanel Grid.Column="1" Orientation="Vertical" Margin="20,0">
                                    <CheckBox x:Name="UseVirusTotalCheckBox" Content="Use VirusTotal API" 
                                              IsChecked="True" Foreground="#CCC" FontSize="12" Margin="0,0,0,5"/>
                                    <CheckBox x:Name="IncludeSubfoldersCheckBox" Content="Include subfolders" 
                                              IsChecked="True" Foreground="#CCC" FontSize="12"/>
                                </StackPanel>
                                
                                <!-- Scan Button -->
                                <Button x:Name="ScanButton" Grid.Column="2" Content="🔍 START SCAN" 
                                        Style="{StaticResource ModernButtonStyle}" 
                                        Click="ScanButton_Click" IsEnabled="False" 
                                        Width="160" Height="50" FontSize="16" FontWeight="Bold"
                                        Background="#FF4444"/>
                                        
                                <Button x:Name="CancelScanButton" Grid.Column="2" Content="✕ CANCEL SCAN" 
                                        Style="{StaticResource ModernButtonStyle}" 
                                        Click="CancelScanButton_Click" 
                                        Width="160" Height="50" FontSize="16" FontWeight="Bold"
                                        Background="#666" Visibility="Collapsed"/>
                            </Grid>
                        </Border>
                        
                        <!-- Scan Results -->
                        <Border Grid.Row="2" Background="#2A2A2A" CornerRadius="6" Margin="40,0,40,20">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                
                                <!-- Progress Bar -->
                                <Border Grid.Row="0" Background="#3A3A3A" Padding="20,15" BorderThickness="0,0,0,1" BorderBrush="#555">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        
                                        <!-- Progress Bar and Percentage -->
                                        <Grid Grid.Row="0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            
                                            <ProgressBar x:Name="ScanProgressBar" Grid.Column="0" Height="12" 
                                                         Background="#555" Foreground="#FF4444" BorderThickness="0" 
                                                         Margin="0,0,15,0"/>
                                            <TextBlock x:Name="ProgressText" Grid.Column="1" Text="0%" 
                                                       Foreground="#FF4444" FontSize="16" FontWeight="Bold" 
                                                       VerticalAlignment="Center"/>
                                        </Grid>
                                        
                                        <!-- Status Text -->
                                        <TextBlock x:Name="ScanStatusText" Grid.Row="1" Text="Ready to scan" 
                                                   Foreground="#CCC" FontSize="14" Margin="0,8,0,0"/>
                                        
                                        <!-- Currently Scanning File -->
                                        <StackPanel x:Name="CurrentFilePanel" Grid.Row="2" Orientation="Horizontal" 
                                                    Margin="0,8,0,0" Visibility="Collapsed">
                                            <TextBlock Text="📄 Scanning: " Foreground="#888" FontSize="12"/>
                                            <TextBlock x:Name="CurrentFileText" Text="" Foreground="#CCC" FontSize="12" 
                                                       TextTrimming="CharacterEllipsis" MaxWidth="500"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                                
                                <!-- Results List -->
                                <DataGrid x:Name="ScanResultsGrid" Grid.Row="1" 
                                          Background="#2A2A2A" Foreground="White" 
                                          BorderThickness="0" GridLinesVisibility="Horizontal" 
                                          HorizontalGridLinesBrush="#444" RowBackground="#2A2A2A" 
                                          AlternatingRowBackground="#333" HeadersVisibility="Column"
                                          AutoGenerateColumns="False" IsReadOnly="True" 
                                          CanUserResizeRows="False" CanUserSortColumns="True"
                                          SelectionMode="Extended">
                                    
                                    <DataGrid.ContextMenu>
                                        <ContextMenu Background="#3A3A3A" Foreground="White">
                                            <MenuItem Header="🗑️ Delete Selected Files" Click="DeleteSelectedFiles_Click" 
                                                      Foreground="White" Background="#3A3A3A"/>
                                            <Separator Background="#555"/>
                                            <MenuItem Header="📋 Copy File Path" Click="CopyFilePath_Click" 
                                                      Foreground="White" Background="#3A3A3A"/>
                                            <MenuItem Header="📂 Open File Location" Click="OpenFileLocation_Click" 
                                                      Foreground="White" Background="#3A3A3A"/>
                                        </ContextMenu>
                                    </DataGrid.ContextMenu>
                                    
                                    <DataGrid.ColumnHeaderStyle>
                                        <Style TargetType="DataGridColumnHeader">
                                            <Setter Property="Background" Value="#444"/>
                                            <Setter Property="Foreground" Value="White"/>
                                            <Setter Property="FontWeight" Value="Bold"/>
                                            <Setter Property="Padding" Value="8,6"/>
                                            <Setter Property="BorderBrush" Value="#555"/>
                                            <Setter Property="BorderThickness" Value="0,0,1,1"/>
                                        </Style>
                                    </DataGrid.ColumnHeaderStyle>
                                    
                                    <DataGrid.CellStyle>
                                        <Style TargetType="DataGridCell">
                                            <Setter Property="Background" Value="Transparent"/>
                                            <Setter Property="Foreground" Value="White"/>
                                            <Setter Property="BorderThickness" Value="0"/>
                                            <Setter Property="Padding" Value="8,4"/>
                                            <Style.Triggers>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter Property="Background" Value="#555"/>
                                                    <Setter Property="Foreground" Value="White"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </DataGrid.CellStyle>
                                    
                                    <DataGrid.RowStyle>
                                        <Style TargetType="DataGridRow">
                                            <Setter Property="Background" Value="#2A2A2A"/>
                                            <Setter Property="Foreground" Value="White"/>
                                            <Style.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="#3A3A3A"/>
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter Property="Background" Value="#555"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </DataGrid.RowStyle>
                                    
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="File Name" Binding="{Binding FileName}" Width="200">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="White"/>
                                                    <Setter Property="FontWeight" Value="Medium"/>
                                                </Style>
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>
                                        
                                        <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="100">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="White"/>
                                                    <Setter Property="FontWeight" Value="Bold"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Status}" Value="Clean">
                                                            <Setter Property="Foreground" Value="#4CAF50"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="Suspicious">
                                                            <Setter Property="Foreground" Value="#FF9800"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="Malicious">
                                                            <Setter Property="Foreground" Value="#F44336"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>
                                        
                                        <DataGridTextColumn Header="Detection" Binding="{Binding DetectionRatio}" Width="100">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="#CCC"/>
                                                </Style>
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>
                                        
                                        <DataGridTextColumn Header="Threats" Binding="{Binding ThreatNamesFormatted}" Width="300">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="#FFB74D"/>
                                                    <Setter Property="TextWrapping" Value="Wrap"/>
                                                </Style>
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>
                                        
                                        <DataGridTextColumn Header="Size" Binding="{Binding FileSizeFormatted}" Width="80">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="#AAA"/>
                                                    <Setter Property="HorizontalAlignment" Value="Right"/>
                                                </Style>
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>
                                        
                                        <DataGridTextColumn Header="Path" Binding="{Binding FilePath}" Width="*">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="#888"/>
                                                    <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                                </Style>
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                        </Border>
                        
                        <!-- Scan Summary -->
                        <Border Grid.Row="3" Background="#2A2A2A" CornerRadius="6" Margin="40,0,40,40" Padding="20,15">
                            <Grid x:Name="ScanSummaryGrid" Visibility="Collapsed">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                
                                <!-- Total Files (Click to show all) -->
                                <Button Grid.Column="0" Background="Transparent" BorderThickness="0" 
                                        Click="FilterResults_Click" Tag="All" Cursor="Hand"
                                        HorizontalAlignment="Center" Padding="10">
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock x:Name="TotalFilesText" Text="0" FontSize="24" FontWeight="Bold" 
                                                   Foreground="White" HorizontalAlignment="Center"/>
                                        <TextBlock Text="Total Files" FontSize="12" Foreground="#AAA" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Setter Property="Background" Value="Transparent"/>
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border Background="{TemplateBinding Background}" 
                                                                CornerRadius="5" Padding="{TemplateBinding Padding}">
                                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter Property="Background" Value="#3A3A3A"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </Button.Style>
                                </Button>
                                
                                <!-- Clean Files (Click to show clean files) -->
                                <Button Grid.Column="1" Background="Transparent" BorderThickness="0" 
                                        Click="FilterResults_Click" Tag="Clean" Cursor="Hand"
                                        HorizontalAlignment="Center" Padding="10">
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock x:Name="CleanFilesText" Text="0" FontSize="24" FontWeight="Bold" 
                                                   Foreground="#4CAF50" HorizontalAlignment="Center"/>
                                        <TextBlock Text="Clean" FontSize="12" Foreground="#AAA" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Setter Property="Background" Value="Transparent"/>
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border Background="{TemplateBinding Background}" 
                                                                CornerRadius="5" Padding="{TemplateBinding Padding}">
                                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter Property="Background" Value="#4CAF5020"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </Button.Style>
                                </Button>
                                
                                <!-- Suspicious Files (Click to show suspicious files) -->
                                <Button Grid.Column="2" Background="Transparent" BorderThickness="0" 
                                        Click="FilterResults_Click" Tag="Suspicious" Cursor="Hand"
                                        HorizontalAlignment="Center" Padding="10">
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock x:Name="SuspiciousFilesText" Text="0" FontSize="24" FontWeight="Bold" 
                                                   Foreground="#FF9800" HorizontalAlignment="Center"/>
                                        <TextBlock Text="Suspicious" FontSize="12" Foreground="#AAA" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Setter Property="Background" Value="Transparent"/>
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border Background="{TemplateBinding Background}" 
                                                                CornerRadius="5" Padding="{TemplateBinding Padding}">
                                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter Property="Background" Value="#FF980020"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </Button.Style>
                                </Button>
                                
                                <!-- Malicious Files (Click to show malicious files) -->
                                <Button Grid.Column="3" Background="Transparent" BorderThickness="0" 
                                        Click="FilterResults_Click" Tag="Malicious" Cursor="Hand"
                                        HorizontalAlignment="Center" Padding="10">
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock x:Name="MaliciousFilesText" Text="0" FontSize="24" FontWeight="Bold" 
                                                   Foreground="#F44336" HorizontalAlignment="Center"/>
                                        <TextBlock Text="Malicious" FontSize="12" Foreground="#AAA" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Setter Property="Background" Value="Transparent"/>
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border Background="{TemplateBinding Background}" 
                                                                CornerRadius="5" Padding="{TemplateBinding Padding}">
                                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter Property="Background" Value="#F4433620"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </Button.Style>
                                </Button>
                                
                                <!-- Duration (Not clickable) -->
                                <StackPanel Grid.Column="4" HorizontalAlignment="Center">
                                    <TextBlock x:Name="ScanDurationText" Text="0s" FontSize="24" FontWeight="Bold" 
                                               Foreground="#2196F3" HorizontalAlignment="Center"/>
                                    <TextBlock Text="Duration" FontSize="12" Foreground="#AAA" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- Input Playground Page -->
                    <Grid x:Name="PlaygroundPage" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>    <!-- Header -->
                            <RowDefinition Height="Auto"/>    <!-- Controls -->
                            <RowDefinition Height="*"/>       <!-- Content -->
                        </Grid.RowDefinitions>
                        
                        <!-- Header -->
                        <TextBlock Grid.Row="0" Text="Input Playground" FontSize="28" FontWeight="Light" 
                                   Foreground="White" Margin="40,40,40,20"/>
                        
                        <!-- Controls -->
                        <Border Grid.Row="1" Background="#2A2A2A" CornerRadius="8" Margin="40,0,40,30" Padding="30,25">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                
                                <!-- Large Start Monitoring Button -->
                                <Button x:Name="MonitoringToggle" Grid.Column="0"
                                        Content="🎯 START MONITORING" 
                                        Style="{StaticResource ModernButtonStyle}" 
                                        Click="MonitoringToggle_Click" 
                                        FontSize="18" FontWeight="Bold"
                                        Padding="40,20" Margin="0,0,30,0"
                                        MinWidth="280" MinHeight="60"/>
                                        
                                <!-- Status Text -->
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="20,0">
                                    <TextBlock x:Name="MonitoringStatus" Text="Global keyboard monitoring disabled" 
                                               Foreground="#888" FontSize="16" FontWeight="Medium"/>
                                    <TextBlock x:Name="MonitoringDetails" Text="Click START to begin capturing keyboard input across all applications" 
                                               Foreground="#666" FontSize="12" Margin="0,5,0,0"/>
                                </StackPanel>
                                
                                <!-- Application Count -->
                                <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                                    <TextBlock Text="Monitored Apps" Foreground="#888" FontSize="12" HorizontalAlignment="Center"/>
                                    <TextBlock x:Name="MonitoredAppsCount" Text="0" Foreground="#4CAF50" 
                                               FontSize="24" FontWeight="Bold" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                        
                        <!-- Content Area -->
                        <Grid Grid.Row="2" Margin="40,0,40,40">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*" MinWidth="400"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="3*" MinWidth="500"/>
                            </Grid.ColumnDefinitions>
                            
                            <!-- Left Section: Application List -->
                            <Border Grid.Column="0" Background="#2A2A2A" CornerRadius="8" Padding="0">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    
                                    <!-- Header -->
                                    <Border Grid.Row="0" Background="#1E1E1E" CornerRadius="8,8,0,0" Padding="20,15">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="📱 Active Applications" 
                                                       Foreground="#FFF" FontSize="16" FontWeight="Bold"/>
                                            <TextBlock Grid.Column="1" x:Name="ActiveAppCount" Text="0 apps" 
                                                       Foreground="#4CAF50" FontSize="14" FontWeight="Medium"/>
                                        </Grid>
                                    </Border>
                                    
                                    <!-- Applications DataGrid -->
                                    <DataGrid x:Name="ApplicationsDataGrid" Grid.Row="1" 
                                              Background="Transparent" Foreground="#DDD" 
                                              BorderThickness="0" GridLinesVisibility="None"
                                              HeadersVisibility="Column" CanUserAddRows="False"
                                              CanUserDeleteRows="False" IsReadOnly="True"
                                              AutoGenerateColumns="False" SelectionMode="Single"
                                              RowBackground="#2A2A2A" AlternatingRowBackground="#333"
                                              ColumnHeaderStyle="{StaticResource BlackHeaderStyle}">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Application" Binding="{Binding ApplicationName}" Width="*" MinWidth="120"/>
                                            <DataGridTextColumn Header="PID" Binding="{Binding ProcessId}" Width="60"/>
                                            <DataGridTextColumn Header="Input Count" Binding="{Binding InputCount}" Width="80"/>
                                            <DataGridTextColumn Header="Last Activity" Binding="{Binding LastActivity}" Width="90"/>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                    
                                    <!-- Action Buttons -->
                                    <Border Grid.Row="2" Background="#1E1E1E" CornerRadius="0,0,8,8" Padding="15,12">
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                            <Button x:Name="RefreshAppsButton" Content="🔄 Refresh Applications" 
                                                    Style="{StaticResource ModernButtonStyle}" 
                                                    Click="RefreshAppsButton_Click"
                                                    Padding="18,10" Margin="0,0,12,0" FontSize="14" FontWeight="SemiBold"
                                                    MinWidth="150" Height="40"/>
                                            <Button x:Name="LocateFileButton" Content="📁 Locate File" 
                                                    Style="{StaticResource ModernButtonStyle}" 
                                                    Click="LocateFileButton_Click"
                                                    Padding="18,10" Margin="0,0,12,0" FontSize="14" FontWeight="SemiBold"
                                                    MinWidth="130" Height="40"/>
                                            <Button x:Name="TerminateProcessButton" Content="❌ Terminate Process" 
                                                    Style="{StaticResource ModernButtonStyle}" 
                                                    Click="TerminateProcessButton_Click"
                                                    Padding="18,10" FontSize="14" FontWeight="SemiBold"
                                                    MinWidth="160" Height="40"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </Border>
                            
                            <!-- Splitter -->
                            <GridSplitter Grid.Column="1" Width="8" Background="Transparent" 
                                          HorizontalAlignment="Center" VerticalAlignment="Stretch"/>
                            
                            <!-- Right Section: Detailed Logging -->
                            <Border Grid.Column="2" Background="#2A2A2A" CornerRadius="8" Padding="0">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    
                                    <!-- Header -->
                                    <Border Grid.Row="0" Background="#1E1E1E" CornerRadius="8,8,0,0" Padding="20,15">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="📋 Activity Log" 
                                                       Foreground="#FFF" FontSize="16" FontWeight="Bold"/>
                                            <TextBlock Grid.Column="1" x:Name="LogEntriesCount" Text="0 entries" 
                                                       Foreground="#4CAF50" FontSize="14" FontWeight="Medium"/>
                                        </Grid>
                                    </Border>
                                    
                                    <!-- Log Controls -->
                                    <Border Grid.Row="1" Background="#333" Padding="15,10">
                                        <Grid>
                                            <Button HorizontalAlignment="Right" x:Name="ClearLogButton" Content="🗑️ Clear Log" 
                                                    Style="{StaticResource ModernButtonStyle}" 
                                                    Click="ClearLogButton_Click"
                                                    Padding="16,8" FontSize="13" FontWeight="SemiBold"
                                                    MinWidth="120"/>
                                        </Grid>
                                    </Border>
                                    
                                    <!-- Log Display -->
                                    <ListView x:Name="ActivityLogList" Grid.Row="2" 
                                              Background="Transparent" Foreground="#CCC" BorderThickness="0"
                                              Padding="15,10" FontFamily="Consolas" FontSize="11"
                                              ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                              ScrollViewer.VerticalScrollBarVisibility="Auto">
                                        <ListView.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,2">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="80"/>
                                                        <ColumnDefinition Width="120"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="{Binding FormattedTimestamp}" 
                                                               Foreground="#888" FontSize="10"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding ApplicationName}" 
                                                               Foreground="#4CAF50" FontWeight="SemiBold"/>
                                                    <TextBlock Grid.Column="2" Text="{Binding Details}" 
                                                               Foreground="#CCC" TextWrapping="Wrap"/>
                                                </Grid>
                                            </DataTemplate>
                                        </ListView.ItemTemplate>
                                    </ListView>
                                    
                                    <!-- Statistics -->
                                    <Border Grid.Row="3" Background="#1E1E1E" CornerRadius="0,0,8,8" Padding="20,12">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            
                                            <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                                                <TextBlock Text="Total Events" Foreground="#888" FontSize="10" HorizontalAlignment="Center"/>
                                                <TextBlock x:Name="TotalEventsCount" Text="0" Foreground="#4CAF50" 
                                                           FontSize="16" FontWeight="Bold" HorizontalAlignment="Center"/>
                                            </StackPanel>
                                            
                                            <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                                                <TextBlock Text="Active Apps" Foreground="#888" FontSize="10" HorizontalAlignment="Center"/>
                                                <TextBlock x:Name="ActiveAppsStatsCount" Text="0" Foreground="#2196F3" 
                                                           FontSize="16" FontWeight="Bold" HorizontalAlignment="Center"/>
                                            </StackPanel>
                                            
                                            <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                                                <TextBlock Text="Session Time" Foreground="#888" FontSize="10" HorizontalAlignment="Center"/>
                                                <TextBlock x:Name="SessionTimeText" Text="00:00:00" Foreground="#FF9800" 
                                                           FontSize="16" FontWeight="Bold" HorizontalAlignment="Center"/>
                                            </StackPanel>
                                            
                                            <StackPanel Grid.Column="3" HorizontalAlignment="Center">
                                                <TextBlock Text="Status" Foreground="#888" FontSize="10" HorizontalAlignment="Center"/>
                                                <TextBlock x:Name="MonitoringStatusIndicator" Text="Stopped" Foreground="#F44336" 
                                                           FontSize="16" FontWeight="Bold" HorizontalAlignment="Center"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </Grid>
                            </Border>
                        </Grid>
                    </Grid>

                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
