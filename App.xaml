<Application x:Class="KeyloggerDetector.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:KeyloggerDetector.Converters"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <!-- Value Converters -->
        <converters:StatusBackgroundConverter x:Key="StatusBackgroundConverter"/>
        <converters:StatusTextConverter x:Key="StatusTextConverter"/>
        <converters:ThreatLevelBackgroundConverter x:Key="ThreatLevelBackgroundConverter"/>
        
        <!-- Boolean to Visibility Converter -->
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </Application.Resources>
</Application>
